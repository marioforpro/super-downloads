---
import Layout from '../layouts/Layout.astro';
import { releases, knownIssues } from '../data/releases.js';

const REPO = 'https://github.com/marioforpro/super-downloads';
const fmt = (iso) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title="What’s new — Super Downloads" description="Every Super Downloads release, newest first: what changed for you, in plain language.">
  <div class="legal">
    <a href="/" class="back">&larr; Back</a>
    <h1>What’s new</h1>
    <p class="updated">The app updates itself — a banner appears when a new version is out. <a href="/#download">Download the latest version</a>.</p>

    <section class="known" id="known-issues" aria-labelledby="known-title">
      <h2 id="known-title">Known issues</h2>
      <ul>
        {knownIssues.map((k) => <li>{k}</li>)}
      </ul>
      <p class="known-help">Something else not working? Write to <a href="mailto:support@superdownloads.app">support@superdownloads.app</a> with the link, or use Settings › Help › Report a problem in the app.</p>
    </section>

    {releases.map((r, i) => (
      <section class="release" id={`v${r.version}`}>
        <h2>
          <a href={`#v${r.version}`}>{r.version}</a>
          {i === 0 && <span class="latest">Latest</span>}
        </h2>
        <p class="date"><time datetime={r.date}>{fmt(r.date)}</time> · <a href={`${REPO}/releases/tag/v${r.version}`}>Release on GitHub</a></p>
        <ul>
          {r.notes.map((n) => <li>{n}</li>)}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .legal {
    max-width: 640px;
    margin: 0 auto;
    padding: 60px 24px 80px;
  }

  .back {
    display: inline-block;
    font-size: 13px;
    color: var(--gray-600);
    margin-bottom: 24px;
  }

  h1 {
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .updated {
    font-size: 13px;
    color: var(--gray-600);
    margin-bottom: 32px;
  }

  .release {
    padding-top: 22px;
    margin-top: 22px;
    border-top: 1px solid var(--gray-200, rgba(127, 127, 127, 0.2));
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 2px;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  .latest {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(31, 201, 128, 0.14);
    color: #0b7a4e;
  }

  .date {
    font-size: 12px;
    color: var(--gray-600);
    margin-bottom: 10px;
  }

  ul {
    padding-left: 20px;
  }

  .known {
    padding: 18px 20px 6px;
    margin-bottom: 8px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--mist);
  }

  .known h2 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .known-help {
    font-size: 13px;
    color: var(--slate);
    line-height: 1.6;
    margin: 4px 0 14px;
  }

  li {
    font-size: 14px;
    color: var(--gray-600);
    line-height: 1.7;
    margin-bottom: 4px;
  }
</style>
