  /* Download */
  .download { background: var(--navy-950); color: var(--white); padding: 120px 0; }
  .download-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .download-icon { border-radius: 14px; margin-bottom: 28px; box-shadow: 0 0 0 1px rgba(213,235,255,.14); }
  .download h2 { font-size: clamp(30px, 3.6vw, 44px); letter-spacing: -0.035em; font-weight: 600; line-height: 1.1; }
  .download-sub { margin-top: 14px; font-size: 17px; line-height: 1.55; color: rgba(213, 235, 255, 0.84); max-width: 32em; }
  .download-buttons { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 36px; }
  .btn-dl { flex-direction: column; gap: 2px; min-width: 240px; padding: 16px 28px; font-size: 17px; }
  .btn-dl small { font-size: 13px; font-weight: 500; opacity: .78; }
  .btn-blue.btn-dl small { opacity: 1; color: var(--navy-800); }
  .download-help { margin-top: 18px; font-size: 15px; color: rgba(213, 235, 255, 0.78); }
  .download-meta { margin-top: 6px; font-size: 13px; color: rgba(213, 235, 255, 0.72); }
  .download-meta a, .install a { color: var(--blue-200); text-decoration: underline; text-underline-offset: 2px; }

  .verify { width: 100%; max-width: 640px; margin-top: 14px; font-size: 13px; color: rgba(213, 235, 255, 0.76); text-align: left; }
  .verify summary { cursor: pointer; width: fit-content; margin: 0 auto; padding: 6px 4px; color: var(--blue-200); text-decoration: underline; text-underline-offset: 2px; }
  .verify p { margin-top: 12px; line-height: 1.6; }
  .verify dl { margin-top: 10px; display: grid; gap: 8px; }
  .verify dl div { display: grid; grid-template-columns: 104px 1fr; gap: 12px; align-items: baseline; }
  .verify dt { color: var(--white); font-weight: 600; }
  .verify dd { display: flex; flex-wrap: wrap; gap: 4px 12px; min-width: 0; }
  .verify code { font-family: "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: var(--blue-50); word-break: break-all; }
  .verify a { color: var(--blue-200); text-decoration: underline; text-underline-offset: 2px; }
  .install {
    width: 100%; max-width: 640px; margin-top: 56px; padding: 28px 32px; text-align: left;
    background: rgba(213, 235, 255, 0.05); border: 1px solid rgba(213, 235, 255, 0.14); border-radius: 14px;
  }
  .install-started:not([hidden]) { animation: rise .3s ease both; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
  .install-started { margin-bottom: 16px; padding: 10px 14px; border-radius: 8px; background: rgba(48,167,255,.16); color: var(--white); font-size: 15px; font-weight: 500; }
  .install h3 { font-size: 19px; font-weight: 600; letter-spacing: -0.015em; }
  .install-steps { margin: 18px 0 0 20px; display: grid; gap: 12px; font-size: 15px; line-height: 1.6; color: rgba(213, 235, 255, 0.84); }
  .install-steps li::marker { color: var(--blue-200); font-weight: 600; }
  .install-steps strong { color: var(--white); font-weight: 600; }
  .install-fallback { margin-top: 20px; padding-top: 18px; border-top: 1px solid rgba(213, 235, 255, 0.12); font-size: 13px; line-height: 1.6; color: rgba(213, 235, 255, 0.76); }
  .install-fallback strong { color: var(--white); }
  .codebox { display: flex; align-items: center; gap: 10px; margin-top: 10px; padding: 8px 8px 8px 12px; background: rgba(0, 0, 0, 0.28); border-radius: 8px; }
  .codebox code { flex: 1; min-width: 0; font-family: "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; color: var(--blue-50); overflow-x: auto; white-space: nowrap; }
  .copy-btn { flex: none; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; color: var(--navy-950); background: var(--blue-200); border: 0; border-radius: 6px; padding: 6px 12px; min-height: 32px; }
  .copy-btn:hover { background: var(--blue-50); }

  /* FAQ */
  .faq-inner { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 64px; align-items: start; }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list details:first-child { border-top: 1px solid var(--line); }
  .faq-list summary {
    list-style: none; cursor: pointer; padding: 20px 36px 20px 0; position: relative;
    font-size: 17px; font-weight: 600; color: var(--ink);
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after {
    content: ''; position: absolute; right: 6px; top: 50%; width: 9px; height: 9px; margin-top: -7px;
    border-right: 2px solid var(--slate); border-bottom: 2px solid var(--slate); transform: rotate(45deg); transition: transform .2s ease;
  }
  .faq-list details[open] summary::after { transform: rotate(-135deg); margin-top: -2px; }
  .faq-list details p { padding: 0 0 20px; font-size: 15px; line-height: 1.65; color: var(--slate); max-width: 40em; }
  .faq-list code { font-family: "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; background: var(--mist); border: 1px solid var(--line); border-radius: 6px; padding: 2px 6px; word-break: break-all; }

  /* Footer */
  .footer { border-top: 1px solid var(--line); padding: 40px 0 48px; }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 15px; }
  .footer-links a { color: var(--slate); display: inline-flex; align-items: center; min-height: 32px; }
  .family { width: 100%; padding: 20px 0 4px; border-top: 1px solid var(--line); }
