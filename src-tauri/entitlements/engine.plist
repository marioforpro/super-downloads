<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the bundled yt-dlp engine (PyInstaller onedir).
     Python's ctypes/cffi (curl_cffi impersonation) needs writable+executable memory.
     Signed by scripts/macos-sign.sh nested; the app itself gets no exceptions. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
