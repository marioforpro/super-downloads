---
// Shared shell for /guides/*: an article that answers one real search, then the download.
// Every download button says which guide it came from (download_clicked {place: guide-<slug>}).
import Layout from './Layout.astro';
import FamilyNav from '../components/FamilyNav.astro';
import { releases } from '../data/releases.js';

interface Props {
  slug: string;
  title: string; // <title>
  description: string;
  h1: string;
  updated: string; // ISO date the facts were last checked
}
const { slug, title, description, h1, updated } = Astro.props;
const REPO = 'https://github.com/marioforpro/super-downloads';
const DMG_ARM = `${REPO}/releases/latest/download/Super-Downloads_aarch64.dmg`;
const DMG_INTEL = `${REPO}/releases/latest/download/Super-Downloads_x64.dmg`;
const VERSION = releases[0].version;
const place = `guide-${slug}`;
const pretty = new Date(`${updated}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const url = `https://superdownloads.app/guides/${slug}`;
const ARTICLE_LD = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: h1,
  description,
  url,
  dateModified: updated,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', '@id': 'https://superdownloads.app/#org', name: 'Super Downloads', url: 'https://superdownloads.app' },
  about: { '@type': 'SoftwareApplication', name: 'Super Downloads', operatingSystem: 'macOS' },
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(ARTICLE_LD)} />
  <main id="main" class="guide">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Super Downloads</a> › <a href="/guides">Guides</a></nav>
    <h1>{h1}</h1>
    <p class="updated">Checked {pretty}</p>
    <article class="prose">
      <slot />
    </article>

    <aside class="cta" aria-labelledby="cta-title">
      <img src="/icon.svg" alt="" width="44" height="44" />
      <div>
        <p class="cta-title" id="cta-title">Skip all of this: Super Downloads</p>
        <p>A free Mac app for editors. Paste a link from YouTube, Vimeo, TikTok and more; get an H.264 MP4 that opens in Premiere Pro, Resolve and Final Cut on the first try.</p>
        <p class="cta-actions">
          <a class="cta-btn js-dmg" href={DMG_ARM} data-arch="arm" data-place={place}>Download for Apple Silicon</a>
          <a class="cta-alt js-dmg" href={DMG_INTEL} data-arch="intel" data-place={place}>Intel Mac</a>
        </p>
        <p class="cta-fine">Free · macOS 12+ (Apple Silicon) or 10.15+ (Intel) · v{VERSION} · <a href="/#install">Install in three steps</a></p>
      </div>
    </aside>

    <p class="more">More: <a href="/guides">all guides</a> · <a href="/faq">help and FAQ</a>.</p>
    <FamilyNav />
  </main>

  <script is:inline define:vars={{ VERSION }}>
    document.querySelectorAll('.js-dmg').forEach(function (a) {
      a.addEventListener('click', function () {
        try {
          window.posthog && window.posthog.capture('download_clicked', {
            platform: a.dataset.arch === 'intel' ? 'macos-x64' : 'macos-arm64',
            version: VERSION,
            place: a.dataset.place,
          });
        } catch (e) {}
      });
    });
  </script>
</Layout>

<style>
  .guide { max-width: 720px; margin: 0 auto; padding: 48px 24px 80px; }
  .crumbs { font-size: 13px; color: var(--gray-600); margin-bottom: 16px; }
  .crumbs a { color: var(--gray-600); }
  h1 { font-size: 34px; line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px; }
  .updated { font-size: 13px; color: var(--gray-600); margin-bottom: 28px; }
  .prose :global(h2) { font-size: 21px; line-height: 1.3; font-weight: 700; margin: 36px 0 10px; }
  .prose :global(h3) { font-size: 17px; font-weight: 700; margin: 24px 0 8px; }
  .prose :global(p), .prose :global(li) { font-size: 16px; line-height: 1.7; color: #334155; }
  .prose :global(p) { margin-bottom: 14px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; margin-bottom: 14px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(code) { font-family: "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; background: var(--mist); border: 1px solid var(--line); border-radius: 6px; padding: 1px 5px; }
  .prose :global(pre) { background: var(--navy-950); color: #e2ecff; border-radius: 10px; padding: 14px 16px; margin: 0 0 16px; overflow-x: auto; }
  .prose :global(pre code) { background: none; border: 0; padding: 0; color: inherit; font-size: 13.5px; line-height: 1.6; white-space: pre; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 14px; }
  .prose :global(.table-wrap) { overflow-x: auto; margin-bottom: 16px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; line-height: 1.5; }
  .prose :global(th) { font-weight: 600; background: var(--mist); }
  .prose :global(.note) { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--mist); font-size: 15px; }
  .cta { display: flex; gap: 16px; align-items: flex-start; margin: 40px 0 24px; padding: 22px; border-radius: 14px; background: var(--navy-950); color: var(--white); }
  .cta img { flex: none; }
  .cta p { font-size: 15px; line-height: 1.6; color: rgba(213, 235, 255, 0.85); }
  .cta .cta-title { font-size: 18px; font-weight: 700; color: var(--white); margin-bottom: 4px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; margin: 14px 0 8px; }
  .cta-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 10px; background: var(--blue); color: var(--navy-950); font-weight: 600; }
  .cta-btn:hover { text-decoration: none; filter: brightness(1.05); }
  .cta-alt, .cta-fine a { color: var(--blue-200); text-decoration: underline; text-underline-offset: 2px; }
  .cta .cta-fine { font-size: 13px; color: rgba(213, 235, 255, 0.7); }
  .cta :focus-visible { outline-color: var(--blue); }
  .more { font-size: 14px; color: var(--slate); margin-bottom: 32px; }
  @media (max-width: 640px) {
    h1 { font-size: 28px; }
    .cta { flex-direction: column; }
  }
</style>
