---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, 'https://superdownloads.app').href;

// Share preview (WhatsApp / X / LinkedIn). Swap the file here only; give a new
// image a new filename so the platforms' caches pick it up. Keep it JPG/PNG < 300 KB.
const OG_IMAGE = {
  url: 'https://superdownloads.app/og/sd-og-home.jpg',
  type: 'image/jpeg',
  width: 1200,
  height: 630,
  alt: 'Super Downloads — the video downloader built for editors. Free for Mac.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a163f" />
    <meta name="color-scheme" content="light only" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Super Downloads" />
    <meta property="og:image" content={OG_IMAGE.url} />
    <meta property="og:image:secure_url" content={OG_IMAGE.url} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE.url} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Super Downloads",
      "description": "macOS video downloader for editors. Save your own, licensed, or authorized videos from YouTube, TikTok and Vimeo — plus Instagram, Facebook, X and LinkedIn using your browser login. Every video is Premiere Pro ready — H.264/MP4.",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "macOS 12+ (Apple Silicon), macOS 10.15+ (Intel)",
      "offers": [
        {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR",
          "name": "Free",
          "description": "Free — no download limit, all platforms, all quality options"
        }
      ],
      "featureList": [
        "Works out of the box with YouTube, TikTok and Vimeo",
        "Supports Instagram, Facebook, X/Twitter and LinkedIn using your browser login",
        "Auto-convert to H.264/AAC/MP4 for editing",
        "Hardware accelerated with VideoToolbox",
        "Audio-only MP3 extraction",
        "Copy a link and press Enter; Batch mode for many links",
        "Drag and drop support",
        "Dark and light themes",
        "Apple Silicon and Intel support"
      ],
      "url": "https://superdownloads.app",
      "downloadUrl": "https://superdownloads.app/#download",
      "softwareVersion": "1.5.1",
      "creator": {
        "@type": "Organization",
        "name": "Super Downloads",
        "url": "https://superdownloads.app"
      }
    }
    </script>
    <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      // Cookieless, anonymous analytics (EU/GDPR): PostHog's cookieless mode
      // stores nothing in the browser and counts unique visitors per day with a
      // server-side hash whose salt changes daily. No person profiles, no session
      // recording, so no consent banner is required.
      // Only the production hosts send. `?internal=1` turns capture off in this
      // browser (our own visits), `?internal=0` turns it back on.
      var sdInternal = false;
      try {
        var sdFlag = new URLSearchParams(location.search).get('internal');
        if (sdFlag === '1') localStorage.setItem('sd_internal', '1');
        if (sdFlag === '0') localStorage.removeItem('sd_internal');
        sdInternal = localStorage.getItem('sd_internal') === '1';
      } catch (e) {}
      var sdProdHost = /^(www\.)?superdownloads\.app$/.test(location.hostname);
      if (sdProdHost && !sdInternal) {
      posthog.init('phc_5nkW8LyRDxnxAZxqxOYVqXdOqWHbZ8G9SP1cMy0iAx7', {
        api_host: 'https://us.i.posthog.com',
        cookieless_mode: 'always',
        person_profiles: 'never',
        disable_session_recording: true,
        // Pageviews + the few custom events the page sends; nothing else loads.
        autocapture: false,
        disable_surveys: true,
        capture_performance: false
      });
      // Every event says which product it came from (one PostHog project for the family).
      posthog.register({ product: 'super-downloads' });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --navy-dark: #0a163f;
    --navy-mid: #162b73;
    --blue-bright: #30a7ff;
    --blue-light: #8cd0ff;
    --blue-pale: #d5ebff;
    --white: #ffffff;
    --gray-100: #f4f7fc;
    --gray-200: #e2e8f0;
    --gray-400: #94a3b8;
    --gray-600: #475569;
    --gray-900: #0f172a;
    /* Landing tokens (brand palette from docs/BRAND.md) */
    --navy-950: #0a163f;
    --navy-800: #162b73;
    --blue: #30a7ff;
    --blue-200: #8cd0ff;
    --blue-50: #d5ebff;
    --ink: #0f172a;
    --slate: #475569;
    --mist: #f4f7fc;
    --line: #e2e8f0;
    --link: #0b6bcb;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Geist Variable", -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
    color: var(--gray-900);
    background: var(--white);
    -webkit-font-smoothing: antialiased;
  }

  html { scroll-behavior: smooth; scroll-padding-top: 72px; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  :focus-visible { outline: 2px solid var(--link); outline-offset: 3px; border-radius: 4px; }
  /* On navy surfaces the bright blue ring has the contrast */
  .nav :focus-visible, .hero :focus-visible, .download :focus-visible { outline-color: var(--blue); }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .skip-link { position: absolute; left: 16px; top: -48px; z-index: 100; padding: 10px 14px; border-radius: 8px; background: var(--white); color: var(--navy-950); font-weight: 600; }
  .skip-link:focus { top: 12px; }

  a {
    color: var(--link);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
