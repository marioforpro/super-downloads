---
import Layout from '../layouts/Layout.astro';
import FamilyNav from '../components/FamilyNav.astro';

// Press kit. Assets live in web/public/press (logos: scripts/press/render-logos.cjs),
// web/public/shots (real app screenshots), web/public/og and web/public/demo.
const SHORT =
  'Super Downloads is a Mac app that saves online video as edit-ready files. Copy a link from YouTube, Vimeo, TikTok, Instagram and more, paste it, and get an H.264 MP4 that opens in Premiere Pro, DaVinci Resolve and Final Cut Pro on the first try. Everything runs on your Mac.';
const LONG = [
  'Super Downloads is the video downloader built for editors. It is a native Mac app that turns a link into a file an editing app imports without complaint: always H.264 video with AAC audio in an MP4, at up to 4K, or audio only as MP3.',
  'Most downloaders hand you whatever a site serves, often VP9 or AV1 in a WebM file that Premiere Pro won’t open. Super Downloads keeps H.264 when the source has it and converts on the Mac’s hardware encoder when it doesn’t.',
  'The flow is three steps: copy a link, paste it, done. Batch mode downloads every video link you copy while you keep browsing. YouTube, Vimeo and TikTok work without a login; Instagram, Facebook, X and LinkedIn use the session in your browser. Everything runs locally, nothing passes through our servers, and the app stops at DRM.',
];
const words = (t: string) => t.trim().split(/\s+/).length;

const SHOTS = [
  { file: 'list-dark', alt: 'Downloads in progress, converting and completed (dark theme)' },
  { file: 'empty-dark', alt: 'A copied link already waiting in the field' },
  { file: 'batch-dark', alt: 'Batch mode: several videos downloading at once' },
  { file: 'convert-light', alt: 'Converting to H.264 for editing (light theme)' },
  { file: 'settings-light', alt: 'Settings: save folder, format, quality, theme and engine updates' },
];
---

<Layout title="Press kit — Super Downloads" description="Logos, screenshots, descriptions and facts about Super Downloads, the video downloader built for editors.">
  <main id="main" class="press">
    <a href="/" class="back">&larr; Back</a>
    <h1>Press kit</h1>
    <p class="lead">Everything you need to write about Super Downloads. Use it freely in articles, reviews and videos. Questions: <a href="mailto:support@superdownloads.app">support@superdownloads.app</a>.</p>

    <section>
      <h2>Facts</h2>
      <dl class="facts">
        <div><dt>Name</dt><dd>Super Downloads (two words)</dd></div>
        <div><dt>Tagline</dt><dd>The video downloader built for editors.</dd></div>
        <div><dt>Platform</dt><dd>macOS: Apple Silicon (macOS 12+) and Intel (macOS 10.15+)</dd></div>
        <div><dt>Price</dt><dd>Free, unlimited downloads, no card</dd></div>
        <div><dt>Output</dt><dd>H.264 + AAC in MP4, up to 4K; MP3 for audio only</dd></div>
        <div><dt>Sites</dt><dd>YouTube, Vimeo, TikTok; Instagram, Facebook, X and LinkedIn with the browser login</dd></div>
        <div><dt>Website</dt><dd><a href="https://superdownloads.app">superdownloads.app</a> · <a href="/changelog">Release notes</a></dd></div>
        <div><dt>Contact</dt><dd><a href="mailto:support@superdownloads.app">support@superdownloads.app</a></dd></div>
      </dl>
    </section>

    <section>
      <h2>Short description <span class="count">{words(SHORT)} words</span></h2>
      <p class="copy">{SHORT}</p>
    </section>

    <section>
      <h2>Long description <span class="count">{LONG.reduce((n, p) => n + words(p), 0)} words</span></h2>
      {LONG.map((p) => <p class="copy">{p}</p>)}
    </section>

    <section>
      <h2>Logo</h2>
      <div class="logos">
        <a class="tile tile-light" href="/press/sd-logo-on-light.png" download><img src="/press/sd-logo-on-light.png" alt="Super Downloads logo for light backgrounds" width="898" height="168" loading="lazy" /><span>On light · PNG</span></a>
        <a class="tile tile-dark" href="/press/sd-logo-on-dark.png" download><img src="/press/sd-logo-on-dark.png" alt="Super Downloads logo for dark backgrounds" width="898" height="168" loading="lazy" /><span>On dark · PNG</span></a>
      </div>
      <p class="files">App icon: <a href="/press/sd-icon.svg" download>SVG</a> · <a href="/press/sd-icon-1024.png" download>PNG 1024</a> · <a href="/press/sd-icon-512.png" download>PNG 512</a>. Please don’t recolor, stretch or add effects.</p>
    </section>

    <section>
      <h2>Screenshots</h2>
      <p class="files">The real app, 1120 px wide. Footage: Blender Studio open movies, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> by the Blender Foundation.</p>
      <div class="shots">
        {SHOTS.map((s) => (
          <a class="shot" href={`/shots/${s.file}.webp`} download>
            <img src={`/shots/${s.file}-560.webp`} alt={s.alt} width="560" loading="lazy" />
            <span>{s.alt}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Share card and demo</h2>
      <div class="shots">
        <a class="shot" href="/og/sd-og-home.jpg" download>
          <img src="/og/sd-og-home.jpg" alt="Share card: the video downloader built for editors" width="560" loading="lazy" />
          <span>Share card · 1200×630 JPG</span>
        </a>
        <a class="shot" href="/demo/demo-1080-v10.mp4" download>
          <img src="/demo/demo-poster-v10.webp" alt="Demo film poster" width="560" loading="lazy" />
          <span>Demo film · 24 s · 1080p MP4</span>
        </a>
      </div>
    </section>
    <FamilyNav />
  </main>
</Layout>

<style>
  .press { max-width: 760px; margin: 0 auto; padding: 60px 24px 96px; }
  .back { display: inline-flex; align-items: center; min-height: 32px; font-size: 13px; color: var(--slate); margin-bottom: 16px; }
  h1 { font-size: clamp(30px, 4vw, 40px); font-weight: 600; letter-spacing: -0.035em; line-height: 1.1; }
  .lead { margin-top: 12px; font-size: 17px; line-height: 1.6; color: var(--slate); max-width: 36em; }
  section { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  h2 { display: flex; align-items: baseline; gap: 12px; font-size: 19px; font-weight: 600; letter-spacing: -0.015em; color: var(--ink); margin-bottom: 14px; }
  .count { font-size: 13px; font-weight: 500; color: var(--slate); }
  .copy { font-size: 15px; line-height: 1.7; color: var(--slate); margin-bottom: 12px; max-width: 40em; }
  .facts { display: grid; }
  .facts div { display: grid; grid-template-columns: 104px 1fr; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; line-height: 1.5; }
  .facts dt { font-weight: 600; color: var(--ink); }
  .facts dd { color: var(--slate); }
  .logos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .tile { display: flex; flex-direction: column; gap: 14px; padding: 28px 24px 16px; border-radius: 12px; border: 1px solid var(--line); }
  .tile:hover { text-decoration: none; }
  .tile img { width: 100%; height: auto; }
  .tile span { font-size: 13px; }
  .tile-light { background: var(--white); }
  .tile-light span { color: var(--slate); }
  .tile-dark { background: var(--navy-950); border-color: var(--navy-950); }
  .tile-dark span { color: var(--blue-200); }
  .files { margin-top: 14px; font-size: 15px; line-height: 1.6; color: var(--slate); }
  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px; }
  .shot { display: flex; flex-direction: column; gap: 8px; color: var(--slate); font-size: 13px; line-height: 1.5; }
  .shot:hover { text-decoration: none; color: var(--ink); }
  .shot img { width: 100%; height: auto; border-radius: 10px; box-shadow: 0 0 0 1px rgba(10,22,63,.12), 0 12px 28px -14px rgba(10,22,63,.3); }
  @media (max-width: 640px) {
    .press { padding: 40px 16px 72px; }
    .logos, .shots { grid-template-columns: 1fr; }
    .facts div { grid-template-columns: 88px 1fr; gap: 12px; }
  }
</style>
