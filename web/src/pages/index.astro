---
import Layout from '../layouts/Layout.astro';

const REPO = 'https://github.com/marioforpro/super-downloads';
const DMG_ARM = `${REPO}/releases/latest/download/Super-Downloads_aarch64.dmg`;
const DMG_INTEL = `${REPO}/releases/latest/download/Super-Downloads_x64.dmg`;

// Version and DMG sizes, read from the latest GitHub release at build time.
// Fallbacks keep the build working offline or when the API rate-limits.
const release = { version: '1.5.3', arm: 97, intel: 109 };
try {
  const res = await fetch('https://api.github.com/repos/marioforpro/super-downloads/releases/latest', {
    headers: { 'User-Agent': 'superdownloads-web', Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    const mb = (name: string) => {
      const asset = data.assets?.find((a: { name: string }) => a.name === name);
      return asset ? Math.round(asset.size / 1e6) : null;
    };
    release.version = String(data.tag_name || '').replace(/^v/, '') || release.version;
    release.arm = mb('Super-Downloads_aarch64.dmg') ?? release.arm;
    release.intel = mb('Super-Downloads_x64.dmg') ?? release.intel;
  }
} catch {}

// Hero timeline: finished downloads sit on V1; the one still downloading in
// the window (CHARGE, 64%) arrives as a clip that is still filling.
const clips = [
  { name: 'Spring.mp4', thumb: 'WhWc3b3KhnY', secs: 464 },
  { name: 'WING IT!.mp4', thumb: 'u9lj-c29dxI', secs: 238 },
  { name: 'Coffee Run.mp4', thumb: 'PVGeM40dABA', secs: 185 },
];
const arriving = { name: 'CHARGE.mp4', thumb: 'UXqq0ZvbOnk', secs: 263, pct: 64 };

// Audio waveform for the A1 track: deterministic bar heights, tiled as an SVG.
const wave = (() => {
  let seed = 7;
  const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
  let bars = '';
  for (let i = 0; i < 64; i++) {
    const h = Math.round(4 + rnd() * 18 * (0.55 + 0.45 * Math.abs(Math.sin(i / 5))));
    bars += `<rect x='${i * 4}' y='${(26 - h) / 2}' width='2' height='${h}' rx='1'/>`;
  }
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='256' height='26' fill='%238cd0ff' fill-opacity='.6'>${bars}</svg>`;
  return `url("data:image/svg+xml;utf8,${svg}")`;
})();

const XATTR = 'xattr -dr com.apple.quarantine "/Applications/Super Downloads.app"';

// One source for the visible FAQ and its JSON-LD. `html` is the visible
// answer when it needs markup; `a` is always the plain-text answer.
const faqs: { id?: string; q: string; a: string; html?: string }[] = [
  {
    q: 'What is Super Downloads?',
    a: 'A native Mac app that saves online video as edit-ready files. YouTube, Vimeo and TikTok work without a login; Instagram, Facebook, X and LinkedIn work through your browser login, on a best-effort basis. Every file is an H.264 MP4 that opens in Premiere Pro, DaVinci Resolve and Final Cut Pro.',
  },
  {
    q: 'What can I download?',
    a: 'Video you own, video you have licensed, video shared under Creative Commons, and anything else you are authorized to use: your own uploads, client footage, approved references. The app does not get around DRM: if a video is copy-protected, it tells you and stops.',
  },
  {
    q: 'How is it different from other downloaders?',
    a: 'Most downloaders hand you whatever the site serves, often VP9 or AV1 in a WebM or MKV file that your editing app won’t import. Super Downloads always gives you H.264 in an MP4, picks up the link you just copied, and keeps its download engine up to date by itself. No Terminal, nothing to configure.',
  },
  {
    q: 'Is it free?',
    a: 'Yes, free for a limited time, with unlimited downloads and every feature. You activate it once with your email inside the app. No card required.',
  },
  {
    q: 'What do you do with my email?',
    a: 'It activates the app and lets us tell you about important changes, such as security fixes or the end of the free period. If you leave the “updates and new products” box ticked, we may also email you about updates and our other products; untick it and we won’t. Every email has a one-click unsubscribe.',
    html: 'It activates the app and lets us tell you about important changes, such as security fixes or the end of the free period. If you leave the “updates and new products” box ticked, we may also email you about updates and our other products; untick it and we won’t. Every email has a one-click unsubscribe. Details in the <a href="/privacy">Privacy Policy</a>.',
  },
  {
    q: 'Why do some platforms need my browser login?',
    a: 'Instagram, Facebook, X and LinkedIn usually serve video only to signed-in users. Super Downloads uses the session already in your default browser (Safari, Chrome, Firefox, Brave, Edge or Vivaldi). It never asks for, sees or stores your password.',
  },
  {
    q: 'A site stopped working. What now?',
    a: 'Sites change how they deliver video all the time. The app checks for a new download engine every week and installs it on its own, which usually fixes it. To check right away, open Settings and click Update next to Engine. Still failing? Write to support@superdownloads.app with the link.',
    html: 'Sites change how they deliver video all the time. The app checks for a new download engine every week and installs it on its own, which usually fixes it. To check right away, open Settings and click <strong>Update</strong> next to Engine. Still failing? Write to <a href="mailto:support@superdownloads.app">support@superdownloads.app</a> with the link.',
  },
  {
    q: 'What quality can I download?',
    a: 'Best (up to 4K), 1080p or 720p, plus audio only as MP3. 1080p and 720p are usually fastest, because most sites already offer them as H.264. When a source only has 4K as VP9 or AV1, Best converts it to H.264 with your Mac’s hardware encoder.',
  },
  {
    q: 'Do my downloads go through your servers?',
    a: 'No. Everything runs on your Mac. Video goes straight from the platform to your save folder.',
  },
  {
    id: 'faq-macos',
    q: 'macOS won’t open the app. Is it safe?',
    a: `Yes. Apple notarization is still in progress, so macOS blocks the first launch. On macOS 15 or later: open the app once, click Done, then go to System Settings › Privacy & Security, scroll down and click Open Anyway. On macOS 14 or earlier: right-click the app, choose Open, then click Open. If macOS says the app is damaged, run this in Terminal: ${XATTR}`,
    html: `Yes. Apple notarization is still in progress, so macOS blocks the first launch. On macOS 15 or later: open the app once, click <strong>Done</strong>, then go to System Settings › Privacy &amp; Security, scroll down and click <strong>Open Anyway</strong>. On macOS 14 or earlier: right-click the app, choose Open, then click Open. If macOS says the app is “damaged”, run this in Terminal:<br /><code>${XATTR.replace(/"/g, '&quot;')}</code>`,
  },
  {
    q: 'Is there a Windows or Linux version?',
    a: 'Not yet. Super Downloads is Mac only: Apple Silicon with macOS 12 Monterey or later, and Intel with macOS 10.15 Catalina or later.',
  },
];
---

<Layout
  title="Super Downloads: The video downloader built for editors"
  description="Free Mac app for video editors. Paste a YouTube, Vimeo or TikTok link and get an H.264 MP4 that opens in Premiere Pro, Resolve or Final Cut."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
  })} />

  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/" aria-label="Super Downloads home">
        <img src="/icon.svg" alt="" width="26" height="26" />
        <span>Super Downloads</span>
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href="#how">How it works</a>
        <a href="#features">Features</a>
        <a href="#faq">FAQ</a>
        <a href="#download" class="btn btn-blue btn-sm">Download</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- Hero: the app window, with its downloads landing on an editing timeline -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>The video downloader built for editors.</h1>
          <p class="lede">Paste a link from YouTube, Vimeo, TikTok and more. Get an H.264 MP4 that drops straight into Premiere Pro, Resolve or Final Cut. No transcoding.</p>
          <div class="hero-actions">
            <a href={DMG_ARM} class="btn btn-blue btn-lg js-dmg" id="hero-dl" data-arch="arm" data-place="hero">Download for Mac</a>
            <p class="hero-meta">
              <span>Free for a limited time. No card.</span>
              <span><span id="hero-arch">Apple Silicon</span> · v{release.version} · <a href="#download" id="hero-other">Intel Mac?</a></span>
            </p>
          </div>
          <p class="mobile-note" id="mobile-note" hidden>Super Downloads is a Mac app. <button type="button" class="link-btn" id="share-link">Send this page to your Mac</button></p>
        </div>

        <figure class="window window-dark hero-window">
          <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i><span>Super Downloads</span></div>
          <img src="/shots/list-dark.webp" srcset="/shots/list-dark-560.webp 560w, /shots/list-dark.webp 1120w" sizes="(max-width: 640px) calc(100vw - 32px), 560px" width="1120" height="722" alt="Super Downloads window: CHARGE downloading at 64%, Sprite Fright converting to H.264, Spring and WING IT! completed" fetchpriority="high" />
        </figure>
      </div>

      <div class="timeline-panel" aria-hidden="true">
        <div class="wrap">
          <div class="timeline">
            <div class="ruler">
              <span>00:00:00:00</span><span>00:05:00:00</span><span>00:10:00:00</span><span>00:15:00:00</span><span>00:20:00:00</span>
            </div>
            <div class="track">
              <b class="track-name">V1</b>
              <div class="clips">
                {clips.map((c) => (
                  <div class="clip" style={`flex-grow:${c.secs}`}>
                    <img src={`/shots/thumbs/${c.thumb}.webp`} alt="" loading="lazy" width="240" height="135" />
                    <span>{c.name}</span>
                  </div>
                ))}
                <div class="clip clip-arriving" style={`flex-grow:${arriving.secs};--pct:${arriving.pct}%`}>
                  <img src={`/shots/thumbs/${arriving.thumb}.webp`} alt="" loading="lazy" width="240" height="135" />
                  <span>{arriving.name} · {arriving.pct}%</span>
                </div>
              </div>
            </div>
            <div class="track">
              <b class="track-name">A1</b>
              <div class="clips">
                {clips.map((c, i) => <div class="clip clip-audio" style={`flex-grow:${c.secs};background-image:${wave};background-position:${-i * 37}px center`}></div>)}
                <div class="clip clip-audio clip-audio-arriving" style={`flex-grow:${arriving.secs};--pct:${arriving.pct}%`}></div>
              </div>
            </div>
            <div class="playhead"><span>00:09:12:08</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works: a real three-step sequence, each step its shortcut -->
    <section id="how" class="section how">
      <div class="wrap split">
        <div>
          <h2>Copy. Switch. Enter.</h2>
          <ol class="steps">
            <li><kbd class="key"><span aria-hidden="true">⌘C</span><span class="sr-only">Command C</span></kbd><span><strong>Copy a link</strong> in your browser: a YouTube video, a Vimeo reference, a client’s Instagram reel.</span></li>
            <li><kbd class="key"><span aria-hidden="true">⌘⇥</span><span class="sr-only">Command Tab</span></kbd><span><strong>Switch to Super Downloads.</strong> The link is already in the field.</span></li>
            <li><kbd class="key"><span aria-hidden="true">↵</span><span class="sr-only">Return</span></kbd><span><strong>Press Enter.</strong> The MP4 lands in your save folder, ready to import.</span></li>
          </ol>
          <p class="aside">Already in the app? <kbd><span aria-hidden="true">⌘</span><span class="sr-only">Command</span></kbd><kbd>V</kbd> pastes and starts the download in one step.</p>
        </div>
        <figure class="window window-dark on-light">
          <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i><span>Super Downloads</span></div>
          <img src="/shots/empty-dark.webp" srcset="/shots/empty-dark-560.webp 560w, /shots/empty-dark.webp 1120w" sizes="(max-width: 640px) calc(100vw - 32px), 560px" width="1120" height="500" alt="A copied YouTube link already in the field, with the Download button highlighted" loading="lazy" />
        </figure>
      </div>
    </section>

    <!-- Features: one claim per row, each shown in the real app -->
    <section id="features" class="section features">
      <div class="wrap">
        <div class="row">
          <div class="row-copy">
            <h2>Files your NLE opens on the first try.</h2>
            <p>Every file is an MP4 that Premiere Pro, Resolve and Final Cut read natively. No transcoding step, no “unsupported codec” dialog.</p>
            <dl class="specs">
              <div><dt>Video</dt><dd>H.264. Kept as is when the source has it, converted on your Mac’s hardware encoder when it doesn’t.</dd></div>
              <div><dt>Audio</dt><dd>AAC. Or audio only, as MP3.</dd></div>
              <div><dt>Quality</dt><dd>Best (up to 4K), 1080p or 720p</dd></div>
              <div><dt>Container</dt><dd>MP4</dd></div>
              <div><dt>Opens in</dt><dd>Premiere Pro, DaVinci Resolve, Final Cut Pro</dd></div>
            </dl>
          </div>
          <figure class="window window-light">
            <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i><span>Super Downloads</span></div>
            <img src="/shots/convert-light.webp" srcset="/shots/convert-light-560.webp 560w, /shots/convert-light.webp 1120w" sizes="(max-width: 640px) calc(100vw - 32px), 560px" width="1120" height="424" alt="Light theme: Sprite Fright converting to H.264 for editing at 41%, Spring completed as a 1080p MP4" loading="lazy" />
          </figure>
        </div>

        <div class="row row-flip">
          <div class="row-copy">
            <h2>Pulling a whole reference board? Turn on Batch.</h2>
            <p>Press <kbd><span aria-hidden="true">⌘</span><span class="sr-only">Command</span></kbd><kbd>B</kbd> and keep browsing. Every video link you copy downloads automatically, even with the app in the background.</p>
            <dl class="specs">
              <div><dt>Start, stop</dt><dd><kbd><span aria-hidden="true">⌘</span><span class="sr-only">Command</span></kbd><kbd>B</kbd>, or the Batch button</dd></div>
              <div><dt>Duplicates</dt><dd>Skipped, along with anything that isn’t a video link</dd></div>
              <div><dt>Each launch</dt><dd>Starts off, so nothing downloads by surprise</dd></div>
            </dl>
          </div>
          <figure class="window window-dark on-light">
            <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i><span>Super Downloads</span></div>
            <img src="/shots/batch-dark.webp" srcset="/shots/batch-dark-560.webp 560w, /shots/batch-dark.webp 1120w" sizes="(max-width: 640px) calc(100vw - 32px), 560px" width="1120" height="672" alt="Batch mode on: three videos downloading in parallel" loading="lazy" />
          </figure>
        </div>

        <div class="row">
          <div class="row-copy">
            <h2>Keeps working when sites change.</h2>
            <p>Video sites change how they deliver video all the time. Super Downloads keeps up on its own, so a link that worked last month still works today.</p>
            <dl class="specs">
              <div><dt>Engine</dt><dd>Checks for updates every week and installs them itself</dd></div>
              <div><dt>App</dt><dd>New versions install with one click</dd></div>
              <div><dt>Settings</dt><dd>Save folder, quality and theme. Set once.</dd></div>
            </dl>
          </div>
          <figure class="window window-light">
            <div class="titlebar" aria-hidden="true"><i></i><i></i><i></i><span>Super Downloads</span></div>
            <img src="/shots/settings-light.webp" srcset="/shots/settings-light-560.webp 560w, /shots/settings-light.webp 1120w" sizes="(max-width: 640px) calc(100vw - 32px), 560px" width="1120" height="740" alt="Settings: save folder, Video MP4 or Audio MP3, quality, theme, and the engine version with an Update button" loading="lazy" />
          </figure>
        </div>
      </div>
    </section>

    <!-- Platforms + trust -->
    <section class="section platforms">
      <div class="wrap">
        <h2>Seven platforms, one paste field.</h2>
        <p class="section-lede">For footage you own, have licensed, or that’s shared under Creative Commons.</p>
        <div class="platform-groups">
          <div>
            <h3>No login needed</h3>
            <ul class="platform-list"><li>YouTube</li><li>Vimeo</li><li>TikTok</li></ul>
          </div>
          <div>
            <h3>With your browser login</h3>
            <ul class="platform-list"><li>Instagram</li><li>Facebook</li><li>X</li><li>LinkedIn</li></ul>
            <p class="platform-note">These sites change often. When one stops working, the weekly engine update usually fixes it.</p>
          </div>
        </div>
        <ul class="facts">
          <li><strong>Runs on your Mac.</strong> Nothing is uploaded, and no download passes through our servers.</li>
          <li><strong>Never sees your passwords.</strong> Signed-in platforms use the session already in your browser.</li>
          <li><strong>Stops at DRM.</strong> If a video is copy-protected, the app tells you and stops. It never tries to get around it.</li>
          <li><strong>Built on open source.</strong> <a href="https://github.com/yt-dlp/yt-dlp">yt-dlp</a> and <a href="https://ffmpeg.org">FFmpeg</a> do the heavy lifting, with full credit in the app.</li>
        </ul>
      </div>
    </section>

    <!-- Download + install guide -->
    <section id="download" class="download">
      <div class="wrap download-inner">
        <img src="/icon.svg" alt="" width="64" height="64" class="download-icon" />
        <h2>Get Super Downloads for Mac</h2>
        <p class="download-sub">Free for a limited time. Unlimited downloads, every feature. Enter your email once in the app to activate.</p>
        <div class="download-buttons">
          <a href={DMG_ARM} class="btn btn-blue btn-dl js-dmg" data-arch="arm" data-place="download">
            <span>Apple Silicon</span><small>M1 or later · macOS 12+ · {release.arm} MB</small>
          </a>
          <a href={DMG_INTEL} class="btn btn-ghost btn-dl js-dmg" data-arch="intel" data-place="download">
            <span>Intel</span><small>Intel chip · macOS 10.15+ · {release.intel} MB</small>
          </a>
        </div>
        <p class="download-help">Not sure which? Apple menu › About This Mac shows your chip.</p>
        <p class="download-meta">Version {release.version} · <a href={`${REPO}/releases`}>Release notes</a> · <a href={REPO}>Source on GitHub</a></p>

        <div class="install" id="install">
          <p class="install-started" id="install-started" role="status" hidden>Your download has started. Three steps and you’re in.</p>
          <h3>Install in three steps</h3>
          <ol class="install-steps">
            <li><strong>Open the .dmg</strong> and drag Super Downloads into Applications.</li>
            <li><strong>Open the app.</strong> macOS says it can’t verify it, because Apple notarization is still in progress. Click <strong>Done</strong>.</li>
            <li><strong>Open System Settings › Privacy &amp; Security</strong>, scroll down and click <strong>Open Anyway</strong>. From then on it opens like any other app.</li>
          </ol>
          <div class="install-fallback">
            <p>On macOS 14 or earlier, right-click the app and choose <strong>Open</strong> instead. If macOS says the app is “damaged”, paste this into Terminal:</p>
            <div class="codebox">
              <code id="xattr-cmd">{XATTR}</code>
              <button type="button" class="copy-btn" data-copy="xattr-cmd">Copy</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section faq">
      <div class="wrap faq-inner">
        <h2>Common questions</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details id={f.id}>
              <summary>{f.q}</summary>
              <p set:html={f.html ?? f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <a class="brand" href="/"><img src="/icon.svg" alt="" width="20" height="20" /><span>Super Downloads</span></a>
      <nav class="footer-links" aria-label="Footer">
        <a href={`${REPO}/releases`}>Release notes</a>
        <a href={REPO}>GitHub</a>
        <a href="mailto:support@superdownloads.app">Support</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/copyright">Copyright</a>
      </nav>
      <p class="footer-fine">Made by <a href="https://mariomonteiro.tv">Mario Monteiro</a>. Super Downloads does not host, store, or distribute any copyrighted content. Download only content you own, have licensed, that’s shared under Creative Commons, or that you’re otherwise authorized to use.</p>
      <p class="footer-fine">Screenshots show Blender Studio open movies (Spring, WING IT!, Coffee Run, CHARGE, Sprite Fright, Agent 327, HERO, Cosmos Laundromat), licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> by the Blender Foundation.</p>
      <p class="footer-fine">© 2026 Super Downloads</p>
    </div>
  </footer>

  <script is:inline define:vars={{ DMG_ARM, DMG_INTEL }}>
    (function () {
      var track = function (event, props) {
        try { window.posthog && window.posthog.capture(event, props); } catch (e) {}
      };

      // Open an FAQ item when linked by hash (e.g. #faq-macos).
      function openFaqFromHash() {
        var el = location.hash && document.querySelector(location.hash);
        if (el && el.tagName === 'DETAILS') el.open = true;
      }
      window.addEventListener('hashchange', openFaqFromHash);
      openFaqFromHash();
      var macFaq = document.getElementById('faq-macos');
      if (macFaq) macFaq.addEventListener('toggle', function () { if (macFaq.open) track('install_help_opened', { place: 'faq' }); });

      // Mac or not: phones and PCs can't install a Mac app, so offer to send the page instead.
      var ua = navigator.userAgent;
      var isTouchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1; // iPadOS reports a Mac UA
      var isMac = /Macintosh/.test(ua) && !isTouchMac; // iPhone UAs say "like Mac OS X"
      var heroDl = document.getElementById('hero-dl');
      if (!isMac) {
        heroDl.hidden = true;
        document.querySelector('.hero-meta').hidden = true;
        document.getElementById('mobile-note').hidden = false;
      }
      document.getElementById('share-link').addEventListener('click', function () {
        var url = 'https://superdownloads.app';
        if (navigator.share) {
          navigator.share({ title: 'Super Downloads', text: 'The video downloader built for editors (Mac).', url: url }).catch(function () {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function () {
            document.getElementById('share-link').textContent = 'Link copied. Open it on your Mac.';
          });
        }
      });

      // Chip detection for the hero button. Chromium reports the architecture;
      // elsewhere the WebGL renderer sometimes names it. Unknown → Apple Silicon.
      function setIntel() {
        heroDl.href = DMG_INTEL;
        heroDl.dataset.arch = 'intel';
        document.getElementById('hero-arch').textContent = 'Intel';
        var other = document.getElementById('hero-other');
        other.textContent = 'Apple Silicon?';
      }
      if (isMac) {
        var uad = navigator.userAgentData;
        if (uad && uad.getHighEntropyValues) {
          uad.getHighEntropyValues(['architecture']).then(function (v) { if (v.architecture === 'x86') setIntel(); }).catch(function () {});
        } else {
          try {
            var gl = document.createElement('canvas').getContext('webgl');
            var ext = gl && gl.getExtension('WEBGL_debug_renderer_info');
            var renderer = ext ? String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL)) : '';
            if (/Intel|AMD|Radeon|NVIDIA/i.test(renderer)) setIntel();
          } catch (e) {}
        }
      }

      // After a DMG click the file downloads in place: point straight at the install steps.
      document.querySelectorAll('.js-dmg').forEach(function (a) {
        a.addEventListener('click', function () {
          track('dmg_click', { arch: a.dataset.arch, place: a.dataset.place });
          document.getElementById('install-started').hidden = false;
          setTimeout(function () {
            document.getElementById('install').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
          }, 150);
        });
      });

      document.querySelectorAll('.copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = document.getElementById(btn.dataset.copy).textContent;
          navigator.clipboard && navigator.clipboard.writeText(text).then(function () {
            btn.textContent = 'Copied';
            track('install_help_opened', { place: 'xattr_copy' });
            setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
          });
        });
      });
    })();
  </script>
</Layout>

<style>
